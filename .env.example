# 复制成 .env 后填写。.env 不进 git。
#   copy .env.example .env

# ===== 数据库 =====
POSTGRES_USER=app
POSTGRES_PASSWORD=devpass
POSTGRES_DB=werewolf
# D15 之前用不到。若本机 5432 被占用，docker-compose 改成 5433，这里也要改。
DATABASE_URL=postgresql+psycopg://app:devpass@localhost:5432/werewolf

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM（D12 才真正用上，先留空）=====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 成本三件套（D25）会用到：夜间/投票走 fast，公开发言走 strong
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
